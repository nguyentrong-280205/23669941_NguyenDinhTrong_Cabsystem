# Generate actual secrets and owner .env files: npm run configure:local
# This file documents keys; do not copy placeholder credentials into a running DB.
# Global Configuration
NODE_ENV=development

# Security Secrets
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
REGISTRATION_SECRET=replace_with_generated_secret
OTP_SECRET=replace_with_generated_secret
NOTIFICATION_PROVIDER_SECRET=replace_with_generated_secret
POSTGRES_USER=cab_admin
POSTGRES_PASSWORD=replace_with_generated_secret
MONGO_ROOT_USER=cab_root
MONGO_ROOT_PASSWORD=replace_with_generated_secret
IDENTITY_DB_PASSWORD=replace_with_generated_secret
BOOKING_DB_PASSWORD=replace_with_generated_secret
PAYMENT_DB_PASSWORD=replace_with_generated_secret
CUSTOMER_DB_PASSWORD=replace_with_generated_secret
DRIVER_DB_PASSWORD=replace_with_generated_secret
TRIP_DB_PASSWORD=replace_with_generated_secret
NOTIFICATION_DB_PASSWORD=replace_with_generated_secret
IDENTITY_SERVICE_TOKEN=replace_with_generated_secret
CUSTOMER_SERVICE_TOKEN=replace_with_generated_secret
DRIVER_SERVICE_TOKEN=replace_with_generated_secret
BOOKING_SERVICE_TOKEN=replace_with_generated_secret
TRIP_SERVICE_TOKEN=replace_with_generated_secret
PAYMENT_SERVICE_TOKEN=replace_with_generated_secret
NOTIFICATION_SERVICE_TOKEN=replace_with_generated_secret
GATEWAY_SERVICE_TOKEN=replace_with_generated_secret
SANDBOX_MODE=true
SANDBOX_URL=http://localhost:3090
PAYMENT_PROVIDER_URL=http://localhost:3090
NOTIFICATION_PROVIDER_URL=http://localhost:3090
REDIS_URL=redis://localhost:6379
ENCRYPTION_KEY=replace_with_generated_64_hex_characters
ENCRYPTION_KEY_VERSION=v1
PAYMENT_PROVIDER_SECRET=replace_with_generated_secret

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Microservices URLs (for internal communication)
GATEWAY_PORT=8080
IDENTITY_SERVICE_URL=http://localhost:3001
CUSTOMER_SERVICE_URL=http://localhost:3002
DRIVER_SERVICE_URL=http://localhost:3003
BOOKING_SERVICE_URL=http://localhost:3004
TRIP_SERVICE_URL=http://localhost:3005
PAYMENT_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3007
