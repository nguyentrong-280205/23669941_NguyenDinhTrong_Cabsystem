# Generate owner-specific .env using npm run configure:local.
PORT=3002
SERVICE_TOKEN=replace_with_generated_secret
SERVICE_TOKENS={}
JWT_SECRET=replace_with_generated_secret
MONGO_URI=mongodb://customer_user:replace_with_generated_secret@localhost:27017/customer_db?replicaSet=rs0&directConnection=true&authSource=customer_db
MONGO_DB=customer_db
KAFKA_BOOTSTRAP_SERVERS=
