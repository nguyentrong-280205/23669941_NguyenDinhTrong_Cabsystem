# Generate owner-specific .env using npm run configure:local.
PORT=3007
SERVICE_TOKEN=replace_with_generated_secret
SERVICE_TOKENS={}
JWT_SECRET=replace_with_generated_secret
MONGO_URI=mongodb://notification_user:replace_with_generated_secret@localhost:27017/notification_db?replicaSet=rs0&directConnection=true&authSource=notification_db
MONGO_DB=notification_db
KAFKA_BOOTSTRAP_SERVERS=
