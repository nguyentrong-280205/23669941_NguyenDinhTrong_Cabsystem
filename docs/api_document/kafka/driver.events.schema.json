{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAB driver integration events v1",
  "allOf": [
    {
      "$ref": "event-envelope.schema.json"
    }
  ],
  "oneOf": [
    {
      "properties": {
        "eventType": {
          "const": "driver.application.reviewed"
        },
        "payload": {
          "type": "object",
          "required": [
            "driverId",
            "userId",
            "approvalStatus",
            "reviewedAt"
          ],
          "properties": {
            "driverId": {
              "type": "string",
              "minLength": 1
            },
            "userId": {
              "type": "string",
              "minLength": 1
            },
            "approvalStatus": {
              "type": "string",
              "enum": [
                "APPROVED",
                "REJECTED"
              ]
            },
            "reviewedAt": {
              "type": "string",
              "minLength": 1,
              "format": "date-time"
            },
            "rejectionReason": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "eventType",
        "payload"
      ]
    }
  ]
}
