{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAB integration event envelope",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "version",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "correlationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  }
}
