    "/api/v1/drivers": {
      "get": {
        "operationId": "driver_get__drivers_nearby",
        "tags": [
          "driver"
        ],
        "summary": "Tìm Driver trong khu vực",
        "description": "Tra c?u theo v? tr? ?? l?u, kh?ng gi?i h?n tu?i v? tr? v? kh?ng lo?i t?i x? c? reservation. Admin/Operator v? Driver ???c truy c?p; Customer b? t? ch?i (403). L?c b?n k?nh/tr?ng th?i tr??c khi s?p x?p distanceKm ASC, driverId v? ph?n trang. Booking matching qua API n?i b? v?n y?u c?u APPROVED/AVAILABLE, v? tr? m?i v? kh?ng reservation.",
        "x-service-owner": "driver",
        "x-contract": "srs",
        "x-fr": [
          "FR79"
        ],
        "parameters": [
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "radiusKm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "exclusiveMinimum": true,
              "minimum": 0,
              "maximum": 5,
              "default": 1
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "AVAILABLE",
                "OFFLINE",
                "BUSY",
                "SUSPENDED"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách sau lọc khoảng cách và quyền",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "page",
                    "limit",
                    "total"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/Driver"
                          },
                          {
                            "type": "object",
                            "required": [
                              "distanceKm"
                            ],
                            "properties": {
                              "distanceKm": {
                                "type": "number",
                                "minimum": 0
                              }
                            }
                          }
                        ]
                      }
                    },
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "limit": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Xác thực/chữ ký thất bại",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sai role, caller hoặc ownership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency chưa sẵn sàng; không suy diễn mutation chưa thực hiện",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-roles": [
          "DRIVER",
          "ADMIN",
          "OPERATOR"
        ]
      }
