{
  "openapi": "3.0.3",
  "info": {
    "title": "CAB System - driver Internal API",
    "version": "2.1.0",
    "description": "Hợp đồng HTTP nội bộ đề xuất theo microservice_design.md mục 10.1. Không public qua Gateway. Service identity và quyền caller bắt buộc được kiểm tra. Port là giá trị mẫu cần khớp Compose."
  },
  "servers": [
    {
      "url": "http://driver-service:{port}",
      "variables": {
        "port": {
          "default": "3003",
          "description": "Port nội bộ theo infra/compose.yaml hiện tại; cấu hình qua biến port khi môi trường thay đổi."
        }
      }
    }
  ],
  "security": [
    {
      "serviceAuth": []
    }
  ],
  "paths": {
    "/api/v1/internal-driver-registrations": {
      "post": {
        "operationId": "driver_post__internal_driver_registrations",
        "tags": [
          "driver"
        ],
        "summary": "Tạo hồ sơ Driver/Vehicle",
        "description": "Idempotent theo registrationId/userId, cùng khóa khác body trả 409; GPLX mã hóa tại rest, không log/echo secret.",
        "x-service-owner": "driver",
        "x-contract": "internal-proposal",
        "x-fr": [],
        "parameters": [
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "registrationId",
                    "driverId",
                    "userId",
                    "approvalStatus",
                    "availabilityStatus"
                  ],
                  "properties": {
                    "registrationId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "driverId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "userId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "approvalStatus": {
                      "type": "string",
                      "minLength": 1,
                      "enum": [
                        "PENDING"
                      ]
                    },
                    "availabilityStatus": {
                      "type": "string",
                      "minLength": 1,
                      "enum": [
                        "OFFLINE"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Xác thực/chữ ký thất bại",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sai role, caller hoặc ownership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Xung đột trạng thái, dữ liệu trùng hoặc idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency chưa sẵn sàng; không suy diễn mutation chưa thực hiện",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-callers": [
          "identity"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "registrationId",
                  "userId",
                  "profile",
                  "vehicle"
                ],
                "properties": {
                  "registrationId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "userId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "profile": {
                    "type": "object",
                    "required": [
                      "licenseNumber"
                    ],
                    "properties": {
                      "licenseNumber": {
                        "type": "string",
                        "minLength": 1,
                        "writeOnly": true
                      }
                    }
                  },
                  "vehicle": {
                    "$ref": "#/components/schemas/VehicleInput"
                  }
                }
              }
            }
          }
        }
      }
    },
