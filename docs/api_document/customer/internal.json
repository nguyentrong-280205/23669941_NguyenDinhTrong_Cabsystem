{
  "openapi": "3.0.3",
  "info": {
    "title": "CAB System - customer Internal API",
    "version": "2.1.0",
    "description": "Hợp đồng HTTP nội bộ đề xuất theo microservice_design.md mục 10.1. Không public qua Gateway. Service identity và quyền caller bắt buộc được kiểm tra. Port là giá trị mẫu cần khớp Compose."
  },
  "servers": [
    {
      "url": "http://customer-service:{port}",
      "variables": {
        "port": {
          "default": "3002",
          "description": "Port nội bộ theo infra/compose.yaml hiện tại; cấu hình qua biến port khi môi trường thay đổi."
        }
      }
    }
  ],
  "security": [
    {
      "serviceAuth": []
    }
  ],
  "paths": {
    "/api/v1/internal-customer-registrations": {
      "post": {
        "operationId": "customer_post__internal_customer_registrations",
        "tags": [
          "customer"
        ],
        "summary": "Tạo hồ sơ Customer idempotent",
        "description": "UNIQUE registrationId/userId. Cùng ID và dữ liệu trả kết quả cũ; khác dữ liệu cùng ID trả 409.",
        "x-service-owner": "customer",
        "x-contract": "internal-proposal",
        "x-fr": [],
        "parameters": [
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "registrationId",
                    "customerId",
                    "userId"
                  ],
                  "properties": {
                    "registrationId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "customerId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "userId": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Xác thực/chữ ký thất bại",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sai role, caller hoặc ownership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Xung đột trạng thái, dữ liệu trùng hoặc idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency chưa sẵn sàng; không suy diễn mutation chưa thực hiện",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-callers": [
          "identity"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "registrationId",
                  "userId"
                ],
                "properties": {
                  "registrationId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "userId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
