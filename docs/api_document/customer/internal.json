              }
            }
          },
          "503": {
            "description": "Dependency chưa sẵn sàng; không suy diễn mutation chưa thực hiện",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-callers": [
          "identity"
        ]
      }
    },
    "/api/v1/internal-customers/{id}": {
      "get": {
        "operationId": "customer_get__internal_customers_id",
        "tags": [
          "customer"
        ],
        "summary": "Kiểm tra Customer/userId",
        "description": "Kiểm tra Customer/userId",
        "x-service-owner": "customer",
        "x-contract": "internal-proposal",
        "x-fr": [],
        "parameters": [
