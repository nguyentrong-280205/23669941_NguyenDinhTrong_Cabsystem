  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT người dùng; verify signature/issuer/audience/exp và ownership ở service."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "correlationId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Point": {
        "type": "object",
        "required": [
          "lat",
          "lng",
          "address"
        ],
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "address": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "BookingStatus": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "CREATED",
          "SEARCHING_DRIVER",
          "DRIVER_ASSIGNED",
          "CONFIRMED",
          "COMPLETED",
          "CANCELED",
          "NO_DRIVER_FOUND"
        ]
      },
      "Booking": {
        "type": "object",
        "required": [
          "bookingId",
          "customerId",
          "pickup",
          "destination",
          "vehicleTypeId",
          "status",
          "createdAt"
        ],
        "properties": {
          "bookingId": {
            "type": "string",
            "minLength": 1
          },
          "customerId": {
            "type": "string",
            "minLength": 1
          },
          "pickup": {
            "$ref": "#/components/schemas/Point"
          },
          "destination": {
            "$ref": "#/components/schemas/Point"
          },
          "vehicleTypeId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "createdAt": {
            "type": "string",
            "minLength": 1,
            "format": "date-time"
          },
          "tripId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Offer": {
        "type": "object",
        "required": [
          "offerId",
          "bookingId",
          "driverId",
          "status",
          "expiresAt",
          "pickup",
          "destination"
        ],
        "properties": {
          "offerId": {
            "type": "string",
            "minLength": 1
          },
          "bookingId": {
            "type": "string",
            "minLength": 1
          },
          "driverId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "PENDING",
              "ACCEPTED",
              "REJECTED",
              "TIMEOUT",
              "CANCELED"
            ]
          },
          "expiresAt": {
