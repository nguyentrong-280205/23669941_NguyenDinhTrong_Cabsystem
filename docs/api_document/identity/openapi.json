    "/api/v1/customers/register": {
      "post": {
        "operationId": "identity_post__auth_register_customer",
        "tags": [
          "identity"
        ],
        "summary": "Đăng ký Customer",
        "description": "Identity điều phối tạo User và hồ sơ Customer bằng registrationId ổn định. Chỉ trả 201 khi cả hai hoàn tất; không tạo trùng hoặc xóa User mù quáng khi timeout.",
        "x-service-owner": "identity",
        "x-contract": "srs",
        "x-fr": [
          "FR01"
        ],
        "parameters": [
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "customerId",
                    "userId"
                  ],
                  "properties": {
                    "customerId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "userId": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "example": {
                  "customerId": "CUS-001",
                  "userId": "USR-001"
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Xung đột trạng thái, dữ liệu trùng hoặc idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Vượt giới hạn gửi/request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Số giây chờ trước lần thử kế tiếp",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "503": {
            "description": "Dependency chưa sẵn sàng; không suy diễn mutation chưa thực hiện",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Timeout upstream; tra cứu/retry bằng cùng ID trước khi bù",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fullName",
                  "password"
                ],
                "properties": {
                  "fullName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "phone": {
                    "type": "string",
                    "minLength": 1
                  },
                  "email": {
                    "type": "string",
                    "minLength": 1,
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "format": "password",
                    "writeOnly": true
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "phone"
                    ]
                  },
                  {
                    "required": [
                      "email"
                    ]
                  }
                ]
              },
              "example": {
                "fullName": "Khách demo",
                "phone": "0900000001",
                "password": "demo-password-placeholder"
              }
            }
          }
        }
      }
    },
