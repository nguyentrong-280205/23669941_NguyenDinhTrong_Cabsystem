          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "registrationToken",
                  "fullName",
                  "password",
                  "licenseNumber",
                  "vehicle"
                ],
                "properties": {
                  "registrationToken": {
                    "type": "string",
                    "minLength": 1,
                    "writeOnly": true
                  },
                  "fullName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "format": "password",
