{
  "openapi": "3.0.3",
  "info": {
    "title": "CAB System - identity API",
    "version": "2.1.0",
    "description": "Hợp đồng thiết kế theo SRS X và kiến trúc 7 service. Mọi request từ client đi qua Gateway; dùng prefix /api/v1. Chưa xác nhận backend đã triển khai. Operation x-contract=extension là đề xuất bổ sung, không phải API nghiệm thu đã chốt."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Gateway demo; đổi sang địa chỉ Gateway thực tế khi triển khai"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/driver-otp-challenges": {
      "post": {
        "operationId": "identity_post__auth_driver_otp_request",
        "tags": [
          "identity"
        ],
        "summary": "Yêu cầu OTP đăng ký Driver",
        "description": "OTP sống 5 phút, gửi lại sau ít nhất 60 giây; không trả mã OTP hoặc ghi mã vào log.",
        "x-service-owner": "identity",
        "x-contract": "srs",
        "x-fr": [
          "FR76"
        ],
        "parameters": [
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "challengeId",
                    "expiresIn"
                  ],
                  "properties": {
                    "challengeId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expiresIn": {
                      "type": "integer",
                      "nullable": true,
                      "example": 300
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Vượt giới hạn gửi/request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Số giây chờ trước lần thử kế tiếp",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "503": {
            "description": "Dependency chưa sẵn sàng; không suy diễn mutation chưa thực hiện",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "phone"
                ],
                "properties": {
                  "phone": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
