{
  "openapi": "3.0.3",
  "info": {
    "title": "CAB System - identity Internal API",
    "version": "2.1.0",
    "description": "Hợp đồng HTTP nội bộ đề xuất theo microservice_design.md mục 10.1. Không public qua Gateway. Service identity và quyền caller bắt buộc được kiểm tra. Port là giá trị mẫu cần khớp Compose."
  },
  "servers": [
    {
      "url": "http://identity-service:{port}",
      "variables": {
        "port": {
          "default": "3001",
          "description": "Port nội bộ theo infra/compose.yaml hiện tại; cấu hình qua biến port khi môi trường thay đổi."
        }
      }
    }
  ],
  "security": [
    {
      "serviceAuth": []
    }
  ],
  "paths": {
    "/api/v1/internal/users/{userId}/profiles": {
      "get": {
        "operationId": "identity_get__internal_users_userId_profile",
        "tags": [
          "identity"
        ],
        "summary": "Đọc thông tin User được phép",
        "description": "Đọc thông tin User được phép",
        "x-service-owner": "identity",
        "x-contract": "internal-proposal",
        "x-fr": [],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Xác thực/chữ ký thất bại",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sai role, caller hoặc ownership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy tài nguyên",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency chưa sẵn sàng; không suy diễn mutation chưa thực hiện",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-callers": [
          "customer",
          "driver"
        ]
      }
    },
    "/api/v1/internal/users/{userId}": {
      "patch": {
        "operationId": "identity_patch__internal_users_userId",
        "tags": [
          "identity"
        ],
        "summary": "Cập nhật/khóa User",
        "description": "operationId dedup; ít nhất một trường thay đổi. Caller chuyển actor context đã xác minh, Identity kiểm tra quyền actor độc lập; không tin actorUserId chỉ vì nằm trong body. Chỉ Admin/Operator có quyền mới được khóa/mở.",
        "x-service-owner": "identity",
        "x-contract": "internal-proposal",
        "x-fr": [],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Xác thực/chữ ký thất bại",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sai role, caller hoặc ownership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy tài nguyên",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Xung đột trạng thái, dữ liệu trùng hoặc idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency chưa sẵn sàng; không suy diễn mutation chưa thực hiện",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-callers": [
          "customer"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "operationId",
                  "actorUserId"
                ],
                "properties": {
                  "operationId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "actorUserId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fullName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "phone": {
                    "type": "string",
                    "minLength": 1
                  },
                  "email": {
                    "type": "string",
                    "minLength": 1,
                    "format": "email"
                  },
                  "status": {
                    "type": "string",
                    "minLength": 1,
                    "enum": [
                      "ACTIVE",
                      "LOCKED",
                      "INACTIVE"
                    ]
                  }
                },
                "additionalProperties": false,
                "anyOf": [
                  {
                    "required": [
                      "fullName"
                    ]
                  },
                  {
                    "required": [
                      "phone"
                    ]
                  },
                  {
                    "required": [
                      "email"
                    ]
                  },
                  {
                    "required": [
                      "status"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Đề xuất JWT service-to-service, audience riêng, không chấp nhận JWT user thay service credential."
      }
    },
    "schemas": {
      "UserProfile": {
        "type": "object",
        "required": [
          "userId",
          "fullName",
          "status"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1
          },
          "fullName": {
            "type": "string",
            "minLength": 1
          },
          "phone": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "format": "email"
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "ACTIVE",
              "LOCKED",
              "INACTIVE"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "correlationId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "x-service-owner": "identity",
  "x-persistence": {
    "engine": "PostgreSQL",
    "database": "identity_db",
    "description": "Metadata thiết kế; contract HTTP không phải schema vật lý. Mỗi service chỉ truy cập database của mình."
  }
}
