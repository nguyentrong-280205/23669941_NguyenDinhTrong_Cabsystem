          "trip"
        ],
        "summary": "Tạo Trip chưa activate",
        "description": "UNIQUE bookingId/assignmentId, snapshot đã xác minh. Retry cùng ID/body trả outcome cũ kể cả đã activate; không reset state. activated là phase kỹ thuật, không thêm enum Trip public. Outbox và state được cập nhật nguyên tử trong MongoDB transaction của trip_db trên replica set, không mở transaction xuyên service.",
        "x-service-owner": "trip",
        "x-contract": "internal-proposal",
        "x-fr": [],
        "parameters": [
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Trip mới ASSIGNED/chưa activate hoặc outcome hiện có khi retry cùng ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "tripId",
                    "assignmentId",
                    "status",
                    "activated"
                  ],
                  "properties": {
                    "tripId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "assignmentId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "$ref": "#/components/schemas/TripStatus"
                    },
                    "activated": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Xác thực/chữ ký thất bại",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
