                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-callers": [
          "booking"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "assignmentId",
                  "tripId",
                  "bookingId",
                  "customerId",
                  "driverId",
                  "vehicleId",
                  "vehicleTypeId",
                  "pickup",
                  "destination"
                ],
                "properties": {
