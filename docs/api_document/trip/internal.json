  "components": {
    "securitySchemes": {
      "serviceAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Đề xuất JWT service-to-service, audience riêng, không chấp nhận JWT user thay service credential."
      }
    },
    "schemas": {
      "TripStatus": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "ASSIGNED",
          "DRIVER_ARRIVING",
          "DRIVER_ARRIVED",
          "PICKED_UP",
          "IN_PROGRESS",
          "COMPLETED",
          "CANCELED"
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "correlationId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Point": {
        "type": "object",
        "required": [
          "lat",
          "lng",
          "address"
        ],
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
