  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT người dùng; verify signature/issuer/audience/exp và ownership ở service."
      }
    },
    "schemas": {
      "Trip": {
        "type": "object",
        "required": [
          "tripId",
          "bookingId",
          "customerId",
          "driverId",
          "vehicleId",
          "status",
          "paymentStatus"
        ],
        "properties": {
          "tripId": {
            "type": "string",
            "minLength": 1
          },
          "bookingId": {
            "type": "string",
            "minLength": 1
          },
          "customerId": {
            "type": "string",
            "minLength": 1
          },
          "driverId": {
            "type": "string",
            "minLength": 1
          },
          "vehicleId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/components/schemas/TripStatus"
          },
          "paymentStatus": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "UNPAID",
              "PAID"
            ]
          },
          "driver": {
            "$ref": "#/components/schemas/Driver"
          },
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle"
          },
          "latestLocation": {
            "type": "object",
            "required": [
              "locationId",
              "latitude",
              "longitude",
              "recordedAt"
            ],
            "properties": {
              "locationId": {
                "type": "string",
                "minLength": 1
              },
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "recordedAt": {
                "type": "string",
                "minLength": 1,
                "format": "date-time"
              }
            },
            "nullable": true
          },
          "locationAvailable": {
            "type": "boolean"
          },
          "review": {
            "type": "object",
            "required": [
              "ratingId",
              "tripId",
              "customerId",
              "driverId",
              "score",
              "comment",
              "createdAt"
            ],
            "properties": {
              "ratingId": {
                "type": "string",
                "minLength": 1
              },
              "tripId": {
                "type": "string",
                "minLength": 1
              },
              "customerId": {
                "type": "string",
                "minLength": 1
              },
              "driverId": {
                "type": "string",
                "minLength": 1
              },
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "comment": {
                "type": "string",
                "description": "Plain text; clients must escape for the display context."
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "nullable": true,
            "description": "Saved review, or null when the trip has not been reviewed."
          }
        }
      },
      "TripStatus": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "ASSIGNED",
          "DRIVER_ARRIVING",
          "DRIVER_ARRIVED",
          "PICKED_UP",
          "IN_PROGRESS",
          "COMPLETED",
          "CANCELED"
        ]
      },
      "Driver": {
        "type": "object",
        "required": [
          "driverId",
          "fullName",
          "approvalStatus",
          "availabilityStatus"
        ],
        "properties": {
          "driverId": {
            "type": "string",
            "minLength": 1
          },
          "userId": {
            "type": "string",
            "minLength": 1
          },
          "fullName": {
            "type": "string",
            "minLength": 1
          },
          "approvalStatus": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED"
            ]
          },
          "availabilityStatus": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "OFFLINE",
              "AVAILABLE",
              "BUSY",
              "SUSPENDED"
            ]
          },
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle"
          },
          "distanceKm": {
            "type": "number",
            "minimum": 0
          },
          "phone": {
            "type": "string",
            "description": "Only visible to Admin/Operator or the driver themselves, when available."
          },
          "email": {
            "type": "string",
            "description": "Only visible to Admin/Operator or the driver themselves, when available."
          },
          "licenseNumber": {
            "type": "string",
            "description": "Only visible to Admin/Operator or the driver themselves, when available."
          }
        }
      },
      "Vehicle": {
        "type": "object",
        "required": [
          "vehicleId",
          "driverId",
          "vehicleTypeId",
          "plateNumber",
          "status"
        ],
        "properties": {
          "vehicleId": {
            "type": "string",
            "minLength": 1
          },
          "driverId": {
            "type": "string",
            "minLength": 1
          },
          "vehicleTypeId": {
            "type": "string",
            "minLength": 1
          },
          "plateNumber": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        }
      },
      "Location": {
        "type": "object",
        "required": [
          "locationId",
          "latitude",
          "longitude",
          "recordedAt"
        ],
        "properties": {
          "locationId": {
            "type": "string",
            "minLength": 1
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "recordedAt": {
            "type": "string",
            "minLength": 1,
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "correlationId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Fare": {
        "type": "object",
        "required": [
          "fareId",
          "tripId",
          "pricingRuleId",
