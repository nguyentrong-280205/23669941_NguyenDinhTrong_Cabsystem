      "patch": {
        "operationId": "trip_patch__trips_id_status",
        "tags": [
          "trip"
        ],
        "summary": "Cập nhật trạng thái chuyến",
        "description": "Chỉ Driver được gán, assignment đã activate. ASSIGNED → DRIVER_ARRIVING → DRIVER_ARRIVED → PICKED_UP → IN_PROGRESS → COMPLETED; cũng cho phép ASSIGNED → DRIVER_ARRIVED. State sai trả 409. Fare lỗi không rollback COMPLETED hoặc giữ Driver BUSY.",
        "x-service-owner": "trip",
        "x-contract": "srs",
        "x-fr": [
          "FR23"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "tripId",
                    "status"
                  ],
                  "properties": {
                    "tripId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "$ref": "#/components/schemas/TripStatus"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Xác thực/chữ ký thất bại",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sai role, caller hoặc ownership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy tài nguyên",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Xung đột trạng thái, dữ liệu trùng hoặc idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency chưa sẵn sàng; không suy diễn mutation chưa thực hiện",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-roles": [
          "DRIVER"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "minLength": 1,
                    "enum": [
                      "DRIVER_ARRIVING",
                      "DRIVER_ARRIVED",
                      "PICKED_UP",
                      "IN_PROGRESS",
                      "COMPLETED"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
