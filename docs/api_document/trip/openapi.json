          "trip"
        ],
        "summary": "Xem chuyến đi và tracking",
        "description": "Customer sở hữu, Driver được gán hoặc Admin/Operator. Ghép driver/vehicle/latestLocation qua API owner theo quyền; vị trí cũ kèm recordedAt, lỗi vị trí thể hiện unavailable. paymentStatus là projection từ Payment.",
        "x-service-owner": "trip",
        "x-contract": "srs",
        "x-fr": [
          "FR29"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Thành công",
